{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "^@/types/(.*)$",
    "^@/stores/(.*)$",
    "^@/services/(.*)$",
    "^@/common/classes(.*)$",
    "^@/common/utils(.*)$",
    "^@/common/helpers(.*)$",
    "^@/common/directives(.*)$",
    "^@/common/composable(.*)$",
    "^@/common/(.*)$",
    "^@/layouts/(.*)$",
    "^@/components/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": ["@trivago/prettier-plugin-sort-imports"]
}
